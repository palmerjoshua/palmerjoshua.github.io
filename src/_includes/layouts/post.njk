---
layout: layouts/base.njk
bodyClass: page-post
---
<div class="page">
  <nav class="topnav">
    <a href="/blog/">← All writing</a>
  </nav>

  <article class="post">
    <header class="post-header">
      <h1>{{ title }}</h1>
      <p class="post-meta">
        <time datetime="{{ page.date | htmlDate }}">{{ page.date | readableDate }}</time>
        {%- if readTime -%}
          <span class="post-meta__sep">·</span>
          <span>{{ readTime }}</span>
        {%- endif -%}
      </p>
    </header>

    <div class="post-body">
      {{ content | safe }}
    </div>
  </article>

  <footer class="page-footer">
    <p><a href="/blog/">← All writing</a> &nbsp;·&nbsp; <a href="/feed.xml">Atom feed</a></p>
  </footer>
</div>
