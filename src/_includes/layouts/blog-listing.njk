---
layout: layouts/base.njk
bodyClass: page-blog-listing
---
<div class="page">
  <nav class="topnav">
    <a href="/">← Home</a>
  </nav>

  <header class="page-header">
    <h1>Writing</h1>
    <p class="page-tagline">Technical notes, investigations, and occasional commentary.</p>
  </header>

  <main>
    <ul class="post-list">
      {%- for post in collections.posts -%}
        <li class="post-list__item">
          <h2 class="post-list__title">
            <a href="{{ post.url }}">{{ post.data.title }}</a>
          </h2>
          <p class="post-list__meta">
            <time datetime="{{ post.date | htmlDate }}">{{ post.date | readableDate }}</time>
          </p>
          {%- if post.data.summary -%}
            <p class="post-list__summary">{{ post.data.summary }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if collections.posts.length === 0 -%}
      <p class="empty-state">No posts yet.</p>
    {%- endif -%}
  </main>

  <footer class="page-footer">
    <p><a href="/feed.xml">Subscribe via Atom feed</a></p>
  </footer>
</div>
